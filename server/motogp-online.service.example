# Copy after adjusting /opt/motogp-online and creating the motogp system user.
[Unit]
Description=MotoGP 09/10 community directory and relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=motogp
Group=motogp
WorkingDirectory=/opt/motogp-online
ExecStart=/usr/bin/python3 /opt/motogp-online/community_server.py --database /var/lib/motogp-online/community.sqlite3 --proxy-secret-file /var/lib/motogp-online/proxy.key
Restart=on-failure
RestartSec=3
StateDirectory=motogp-online
StateDirectoryMode=0700
UMask=0077
MemoryMax=384M
TasksMax=32
LimitNOFILE=1024
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
PrivateDevices=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/motogp-online

[Install]
WantedBy=multi-user.target
