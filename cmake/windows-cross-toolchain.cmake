set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_C_COMPILER /workspace/shared/sysroot/usr/lib/llvm-20/bin/clang)
set(CMAKE_CXX_COMPILER /workspace/shared/sysroot/usr/lib/llvm-20/bin/clang++)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_RC_COMPILER /workspace/shared/sysroot/usr/lib/llvm-20/bin/llvm-rc)
set(CMAKE_MT /workspace/shared/sysroot/usr/lib/llvm-20/bin/llvm-mt)
set(CMAKE_LINKER /workspace/shared/sysroot/usr/lib/llvm-20/bin/lld-link)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
set(_winroot /workspace/shared/windows-sysroot)
set(_headers "-isystem /workspace/shared/sysroot/usr/lib/llvm-20/lib/clang/20/include -fms-compatibility-version=19.44 -isystem ${_winroot}/crt/include -isystem ${_winroot}/sdk/include/ucrt -isystem ${_winroot}/sdk/include/shared -isystem ${_winroot}/sdk/include/um -isystem ${_winroot}/sdk/include/winrt")
set(CMAKE_C_FLAGS_INIT "${_headers}")
set(CMAKE_CXX_FLAGS_INIT "${_headers}")
set(_winlibs "-fuse-ld=lld -Xlinker /libpath:${_winroot}/crt/lib/x86_64 -Xlinker /libpath:${_winroot}/sdk/lib/ucrt/x86_64 -Xlinker /libpath:${_winroot}/sdk/lib/um/x86_64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_winlibs}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_winlibs}")
