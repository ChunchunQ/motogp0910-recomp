+bool D3D12Presenter::PrepareTemporalInputs(ID3D12GraphicsCommandList* commands,uint32_t width,uint32_t height) {
+  if(temporal_inputs_ready_)return true;
+  auto* device=provider_.GetDevice();
+  std::array<Microsoft::WRL::ComPtr<ID3D12Resource>,2> textures,uploads;
+  std::array<D3D12_PLACED_SUBRESOURCE_FOOTPRINT,2> footprints{};
+  for(size_t i=0;i<2;++i){
+    D3D12_RESOURCE_DESC desc{};desc.Dimension=D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width=width;desc.Height=height;desc.DepthOrArraySize=1;desc.MipLevels=1;
+    desc.Format=i?DXGI_FORMAT_R16G16_FLOAT:DXGI_FORMAT_R32_FLOAT;
+    desc.SampleDesc.Count=1;desc.Layout=D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    if(FAILED(device->CreateCommittedResource(&util::kHeapPropertiesDefault,D3D12_HEAP_FLAG_NONE,
+        &desc,D3D12_RESOURCE_STATE_COPY_DEST,nullptr,IID_PPV_ARGS(&textures[i]))))return false;
+    UINT64 bytes=0;device->GetCopyableFootprints(&desc,0,1,0,&footprints[i],nullptr,nullptr,&bytes);
+    D3D12_RESOURCE_DESC upload{};upload.Dimension=D3D12_RESOURCE_DIMENSION_BUFFER;upload.Width=bytes;
+    upload.Height=1;upload.DepthOrArraySize=1;upload.MipLevels=1;upload.SampleDesc.Count=1;
+    upload.Layout=D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    if(FAILED(device->CreateCommittedResource(&util::kHeapPropertiesUpload,D3D12_HEAP_FLAG_NONE,
+        &upload,D3D12_RESOURCE_STATE_GENERIC_READ,nullptr,IID_PPV_ARGS(&uploads[i]))))return false;
+    uint8_t* mapped=nullptr;D3D12_RANGE read{0,0};
+    if(FAILED(uploads[i]->Map(0,&read,reinterpret_cast<void**>(&mapped))))return false;
+    std::memset(mapped,0,static_cast<size_t>(bytes));
+    if(!i)for(uint32_t y=0;y<height;++y){
+      auto* row=reinterpret_cast<float*>(mapped+footprints[i].Offset+UINT64(y)*footprints[i].Footprint.RowPitch);
+      std::fill(row,row+width,1.0f);
+    }
+    uploads[i]->Unmap(0,nullptr);
+  }
+  for(size_t i=0;i<2;++i){
+    D3D12_TEXTURE_COPY_LOCATION from{},to{};from.pResource=uploads[i].Get();
+    from.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;from.PlacedFootprint=footprints[i];
+    to.pResource=textures[i].Get();to.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    commands->CopyTextureRegion(&to,0,0,0,&from,nullptr);
+    D3D12_RESOURCE_BARRIER barrier{};barrier.Type=D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier.Transition.pResource=textures[i].Get();barrier.Transition.Subresource=D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    barrier.Transition.StateBefore=D3D12_RESOURCE_STATE_COPY_DEST;
+    barrier.Transition.StateAfter=D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE|D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    commands->ResourceBarrier(1,&barrier);
+  }
+  temporal_inputs_=std::move(textures);temporal_input_uploads_=std::move(uploads);
+  temporal_inputs_ready_=true;return true;
+}
